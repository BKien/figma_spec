Project travel_booking {
  database_type: 'MySQL'
  Note: 'MySQL 8.0 persistence contract. All datetime values are UTC. Apply persistence-constraints.sql after the generated schema.'
}

// Domain operations are constrained by use-case OCL. This file describes persistence.
// MySQL concurrency triggers and additional checks are in persistence-constraints.sql.
// Public opaque IDs encode char(36) values stored as char(36) primary keys. Snapshot JSON contains no credentials.

Enum flight_journey_direction {
  OUTBOUND
  INBOUND
}

Enum moderation_status {
  PENDING
  APPROVED
  REJECTED
}

Enum search_kind {
  STAY
  TAXI
  FLIGHT
}

Enum booking_status {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

Enum quote_status {
  ACTIVE
  EXPIRED
  CONSUMED
  UNAVAILABLE
}

Enum payment_mode {
  ONLINE
  PAY_DRIVER
}

Enum payment_status {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  FAILED
  REFUNDED
}

Enum vehicle_category {
  SMALL
  MEDIUM
  LARGE
  ESTATE
}

Enum transmission_type {
  MANUAL
  AUTOMATIC
}

Enum electric_type {
  NONE
  FULLY_ELECTRIC
  HYBRID
}

Enum booking_for {
  MAIN_GUEST
  SOMEONE_ELSE
}

Enum offer_status {
  ACTIVE
  EXPIRED
  UNAVAILABLE
}

Table users {
  id char(36) [pk]
  full_name text [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table sessions {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  token_hash varchar(255) [not null, unique]
  expires_at datetime [not null]
  revoked_at datetime
  created_at datetime [not null]

  indexes { (user_id, expires_at) }
}

Table locations {
  id char(36) [pk]
  name text [not null]
  normalized_name text [not null]
  country_code char(2) [not null]
  latitude decimal(9,6)
  longitude decimal(9,6)
  active boolean [not null, default: true]

  indexes { (normalized_name, country_code) }
time_zone varchar(80) [not null]
  air_travel boolean [not null, default: false]
  service_area_id char(36) [ref: > service_areas.id]
}

Table stays {
  id char(36) [pk]
  location_id char(36) [not null, ref: > locations.id]
  name text [not null]
  description text [not null]
  address text [not null]
  rating decimal(2,1) [not null]
  review_count int [not null, default: 0]
  contact_email varchar(255)
  contact_phone varchar(40)
  active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table stay_amenities {
  stay_id char(36) [not null, ref: > stays.id]
  amenity_code varchar(80) [not null]

  indexes { (stay_id, amenity_code) [pk] }
}

Table stay_media {
  id char(36) [pk]
  stay_id char(36) [not null, ref: > stays.id]
  media_url text [not null]
  sort_order int [not null]

  indexes { (stay_id, sort_order) [unique] }
}

Table stay_offers {
  id char(36) [pk]
  stay_id char(36) [not null, ref: > stays.id]
  provider_offer_ref varchar(255) [not null]
  check_in date [not null]
  check_out date [not null]
  rooms int [not null]
  adults int [not null]
  available_rooms int [not null]
  total_amount decimal(14,2) [not null]
  currency char(3) [not null]
  status offer_status [not null]
  expires_at datetime [not null]
  version int [not null, default: 1]

  indexes {
    provider_offer_ref [unique]
    (stay_id, check_in, check_out)
  }
}

Table stay_quotes {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  offer_id char(36) [not null, ref: > stay_offers.id]
  total_amount decimal(14,2) [not null]
  currency char(3) [not null]
  status quote_status [not null]
  offer_version int [not null]
  expires_at datetime [not null]
  created_at datetime [not null]

  indexes { (user_id, expires_at) }
}

Table payment_references {
  id char(36) [pk]
  provider varchar(80) [not null]
  provider_reference varchar(255) [not null, unique]
  token_fingerprint varchar(255) [not null]
  status payment_status [not null]
  created_at datetime [not null]
}


Table saved_payment_methods {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  provider varchar(80) [not null]
  provider_reference varchar(255) [not null, unique]
  display_label varchar(120)
  created_at datetime [not null]

  indexes { (user_id, created_at) }
}

Table stay_bookings {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  quote_id char(36) [not null, unique, ref: > stay_quotes.id]
  payment_reference_id char(36) [ref: > payment_references.id]
  saved_payment_method_id char(36) [ref: > saved_payment_methods.id]
  idempotency_key varchar(255) [not null]
  guest_first_name text [not null]
  guest_last_name text [not null]
  guest_home_address text [not null]
  guest_email varchar(255) [not null]
  guest_phone varchar(40) [not null]
  guest_country_code char(2) [not null]
  booking_for booking_for [not null]
  work_travel boolean [not null, default: false]
  total_amount decimal(14,2) [not null]
  currency char(3) [not null]
  status booking_status [not null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes { (user_id, idempotency_key) [unique] }
request_fingerprint varchar(255) [not null]
  provider_reservation_ref varchar(255) [not null, unique]
  completed_at datetime
}

Table drivers {
  id char(36) [pk]
  full_name text [not null]
  phone varchar(40) [not null]
  image_url text
  active boolean [not null, default: true]
}

Table vehicles {
  id char(36) [pk]
  display_name text [not null]
  registration_number varchar(80) [not null, unique]
  category vehicle_category [not null]
  transmission transmission_type [not null]
  electric_type electric_type [not null, default: 'NONE']
  seat_capacity int [not null]
  large_bag_capacity int [not null, default: 0]
  small_bag_capacity int [not null, default: 0]
  image_url text
  active boolean [not null, default: true]
}

Table taxi_offers {
  id char(36) [pk]
  location_id char(36) [not null, ref: > locations.id]
  driver_id char(36) [not null, ref: > drivers.id]
  vehicle_id char(36) [not null, ref: > vehicles.id]
  provider_offer_ref varchar(255) [not null, unique]
  pickup_at datetime [not null]
  dropoff_at datetime [not null]
  passengers int [not null]
  distance_from_center_km decimal(10,2) [not null]
  mileage_allowance_km decimal(10,2) [not null]
  deposit_amount decimal(14,2) [not null]
  total_amount decimal(14,2) [not null]
  currency char(3) [not null]
  rating decimal(2,1) [not null]
  payment_mode payment_mode [not null]
  status offer_status [not null]
  expires_at datetime [not null]
  version int [not null, default: 1]

  indexes { (location_id, pickup_at, dropoff_at) }
}

Table taxi_quotes {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  offer_id char(36) [not null, ref: > taxi_offers.id]
  total_amount decimal(14,2) [not null]
  deposit_amount decimal(14,2) [not null]
  currency char(3) [not null]
  payment_mode payment_mode [not null]
  status quote_status [not null]
  offer_version int [not null]
  expires_at datetime [not null]
  created_at datetime [not null]

  indexes { (user_id, expires_at) }
}

Table taxi_bookings {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  quote_id char(36) [not null, unique, ref: > taxi_quotes.id]
  offer_id char(36) [not null, ref: > taxi_offers.id]
  driver_id char(36) [not null, ref: > drivers.id]
  vehicle_id char(36) [not null, ref: > vehicles.id]
  payment_reference_id char(36) [ref: > payment_references.id]
  saved_payment_method_id char(36) [ref: > saved_payment_methods.id]
  idempotency_key varchar(255) [not null]
  guest_first_name text [not null]
  guest_last_name text [not null]
  guest_home_address text [not null]
  guest_email varchar(255) [not null]
  guest_phone varchar(40) [not null]
  guest_country_code char(2) [not null]
  booking_for booking_for [not null]
  work_travel boolean [not null, default: false]
  total_amount decimal(14,2) [not null]
  currency char(3) [not null]
  status booking_status [not null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (user_id, idempotency_key) [unique]
    (offer_id, status)
  }
request_fingerprint varchar(255) [not null]
  completed_at datetime
}

Table flight_providers {
  id char(36) [pk]
  code varchar(40) [not null, unique]
  name text [not null]
  active boolean [not null, default: true]
}

Table flight_offers {
  id char(36) [pk]
  provider_id char(36) [not null, ref: > flight_providers.id]
  provider_offer_ref varchar(255) [not null]
  origin_location_id char(36) [not null, ref: > locations.id]
  destination_location_id char(36) [not null, ref: > locations.id]
  passengers int [not null]
  duration_minutes int [not null]
  total_amount decimal(14,2) [not null]
  currency char(3) [not null]
  status offer_status [not null]
  expires_at datetime [not null]
  retrieved_at datetime [not null]

  indexes {
    (provider_id, provider_offer_ref) [unique]
    (provider_id, itinerary_signature, fare_fingerprint) [unique]
    (origin_location_id, destination_location_id, retrieved_at)
  }
fare_fingerprint varchar(255) [not null]
  itinerary_signature text [not null]
  seats_remaining int [not null]
  stop_count int [not null]
  best_score decimal(12,6) [not null]
}

Table flight_segments {
  id char(36) [pk]
  flight_offer_id char(36) [not null, ref: > flight_offers.id]
  segment_order int [not null]
  origin_code varchar(12) [not null]
  destination_code varchar(12) [not null]
  carrier_code varchar(12) [not null]
  departure_at datetime [not null]
  arrival_at datetime [not null]

  indexes { (flight_offer_id, journey_direction, segment_order) [unique] }
journey_direction flight_journey_direction [not null]
  origin_location_id char(36) [not null, ref: > locations.id]
  destination_location_id char(36) [not null, ref: > locations.id]
}

Table budget_trips {
  id char(36) [pk]
  destination_location_id char(36) [not null, ref: > locations.id]
  title text [not null]
  description text [not null]
  starting_amount decimal(14,2) [not null]
  currency char(3) [not null]
  active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime [not null]
publish_from datetime [not null]
  publish_until datetime
  editorial_rank int [not null]
}

Table budget_trip_attractions {
  id char(36) [pk]
  budget_trip_id char(36) [not null, ref: > budget_trips.id]
  name text [not null]
  description text
  sort_order int [not null]

  indexes { (budget_trip_id, sort_order) [unique] }
destination_location_id char(36) [not null, ref: > locations.id]
  published boolean [not null, default: false]
}

Table budget_trip_media {
  id char(36) [pk]
  budget_trip_id char(36) [not null, ref: > budget_trips.id]
  media_url text [not null]
  sort_order int [not null]

  indexes { (budget_trip_id, sort_order) [unique] }
}

Table reviews {
  id char(36) [pk]
  author_name text [not null]
  rating int [not null]
  comment text [not null]
  published boolean [not null, default: false]
  published_at datetime
  created_at datetime [not null]

  indexes { (published, published_at) }
author_id char(36) [ref: > users.id]
  stay_id char(36) [ref: > stays.id]
  stay_booking_id char(36) [ref: > stay_bookings.id]
  taxi_booking_id char(36) [ref: > taxi_bookings.id]
  moderation_status moderation_status [not null, default: 'PENDING']
  featured_rank int
}

Table idempotency_records {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  operation text [not null]
  idempotency_key varchar(255) [not null]
  request_fingerprint varchar(255) [not null]
  resource_type varchar(80)
  resource_id char(36)
  expires_at datetime [not null]
  created_at datetime [not null]

  indexes { (user_id, operation, idempotency_key) [unique] }
}


Table service_areas {
  id char(36) [pk]
  name text [not null]
  active boolean [not null, default: true]
}

Table budget_trip_price_evidence {
  id char(36) [pk]
  budget_trip_id char(36) [not null, ref: > budget_trips.id]
  amount decimal(14,2) [not null]
  currency char(3) [not null]
  active boolean [not null, default: true]
  observed_at datetime [not null]
  indexes { (budget_trip_id, currency, observed_at) }
}

Table search_snapshots {
  id char(36) [not null]
  version int [not null]
  kind search_kind [not null]
  currency char(3) [not null]
  criteria_fingerprint text [not null]
  refinement_fingerprint text [not null]
  captured_at datetime [not null]
  valid_until datetime [not null]
  criteria json [not null]
  indexes { (id, version) [pk] }
}

Table search_snapshot_items {
  search_context_id char(36) [not null]
  snapshot_version int [not null]
  rank int [not null]
  stay_offer_id char(36) [ref: > stay_offers.id]
  taxi_offer_id char(36) [ref: > taxi_offers.id]
  flight_offer_id char(36) [ref: > flight_offers.id]
  observed_offer json [not null]
  indexes {
    (search_context_id, snapshot_version, rank) [pk]
    (search_context_id, snapshot_version, stay_offer_id) [unique]
    (search_context_id, snapshot_version, taxi_offer_id) [unique]
    (search_context_id, snapshot_version, flight_offer_id) [unique]
  }
}

Ref: search_snapshot_items.(search_context_id, snapshot_version) > search_snapshots.(id, version)

// Active resource claims are inserted with PENDING/CONFIRMED bookings and released
// with FAILED/CANCELLED outcomes in the same transaction. Keep booking history.
Table taxi_allocations {
  booking_id char(36) [pk, ref: > taxi_bookings.id]
  driver_id char(36) [not null, ref: > drivers.id]
  vehicle_id char(36) [not null, ref: > vehicles.id]
  pickup_at datetime [not null]
  dropoff_at datetime [not null]
  indexes {
    (driver_id, pickup_at, dropoff_at)
    (vehicle_id, pickup_at, dropoff_at)
  }
}
